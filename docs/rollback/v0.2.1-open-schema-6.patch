+
+    /// Rollback build: a database Witness 0.3.x migrated to schema 6 opens,
+    /// and the writes keep the 0.3.x invariants. The SQL below is 0.3.x's
+    /// v6 migration verbatim.
+    #[test]
+    fn rollback_opens_a_schema_six_database() {
+        let (db, dir) = test_db("schema6");
+        let path = dir.join("test.db");
+        let before = db
+            .create_meeting("Meeting 2026-08-01 12:00", "2026-08-01T12:00:00Z", "auto")
+            .unwrap();
+        drop(db);
+        let conn = Connection::open(&path).unwrap();
+        conn.execute_batch(
+            r#"
+            BEGIN;
+            ALTER TABLE meetings ADD COLUMN title_source TEXT NOT NULL DEFAULT 'user';
+            ALTER TABLE meetings ADD COLUMN ai_summary TEXT NOT NULL DEFAULT '';
+            ALTER TABLE meetings ADD COLUMN ai_summary_at TEXT;
+            ALTER TABLE meetings ADD COLUMN ai_summary_stale INTEGER NOT NULL DEFAULT 0;
+            ALTER TABLE meetings ADD COLUMN transcript_rev INTEGER NOT NULL DEFAULT 0;
+            UPDATE meetings SET title_source = 'auto'
+              WHERE title GLOB 'Meeting [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]';
+            PRAGMA user_version = 6;
+            COMMIT;
+            "#,
+        )
+        .unwrap();
+        conn.execute(
+            "UPDATE meetings SET ai_summary = '## Summary', title_source = 'ai' WHERE id = ?1",
+            params![before],
+        )
+        .unwrap();
+        drop(conn);
+
+        let db = Db::open(&path).expect("a schema-6 database opens");
+        let column = |id: i64, name: &str| -> String {
+            let conn = db.conn.lock().unwrap();
+            conn.query_row(
+                &format!("SELECT CAST({name} AS TEXT) FROM meetings WHERE id = ?1"),
+                params![id],
+                |row| row.get(0),
+            )
+            .unwrap()
+        };
+        assert_eq!(db.list_meetings(0, 10).unwrap().len(), 1);
+        let id = db
+            .create_meeting("Meeting 2026-08-02 09:00", "2026-08-02T09:00:00Z", "auto")
+            .unwrap();
+        assert_eq!(column(id, "title_source"), "auto");
+        db.rename_meeting(id, "Typed in the rollback build").unwrap();
+        assert_eq!(column(id, "title_source"), "user");
+        db.replace_transcript(before, &[], &[], "parakeet").unwrap();
+        assert_eq!(column(before, "ai_summary_stale"), "1");
+        assert_eq!(column(before, "transcript_rev"), "1");
+        assert_eq!(column(before, "ai_summary"), "## Summary", "kept");
+        {
+            let conn = db.conn.lock().unwrap();
+            let version: i32 = conn
+                .query_row("PRAGMA user_version", [], |r| r.get(0))
+                .unwrap();
+            assert_eq!(version, 6, "never downgraded");
+            conn.execute_batch("PRAGMA user_version = 7;").unwrap();
+        }
+        drop(db);
+        assert!(Db::open(&path).is_err(), "anything newer is still refused");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
