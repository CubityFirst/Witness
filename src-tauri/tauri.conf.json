{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Witness",
  "version": "0.1.0",
  "identifier": "com.github.cubityfirst.witness",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Witness",
        "width": 460,
        "height": 620,
        "minWidth": 460,
        "minHeight": 360,
        "resizable": true,
        "visible": true,
        "decorations": false,
        "zoomHotkeysEnabled": true,
        "backgroundColor": "#14161a"
      }
    ],
    "security": {
      "capabilities": ["main", "captions"],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "target/release/onnxruntime_providers_cuda.dll": "./",
      "target/release/onnxruntime_providers_shared.dll": "./"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {}
}
