{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Witness",
  "version": "0.2.0",
  "identifier": "com.github.cubityfirst.witness",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Witness",
        "width": 460,
        "height": 620,
        "minWidth": 460,
        "minHeight": 360,
        "resizable": true,
        "visible": true,
        "decorations": false,
        "zoomHotkeysEnabled": true,
        "backgroundColor": "#14161a"
      }
    ],
    "security": {
      "capabilities": ["main", "captions"],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBMDZGNzZEMDBFNkFDRDgKUldUWXJPWUFiZmNHV2l6NDROVllaYWN2R0pMYmY3Rzg4N2EwUTh3bWN3RUN2ci9rRVhQZHgwcGEK",
      "endpoints": [
        "https://github.com/CubityFirst/Witness/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
