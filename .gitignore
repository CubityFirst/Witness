# Tauri-era dev data dirs: untracked, but they hold real dev data (databases,
# audio, models). Never delete them; dev settings point data_dir at them.
src-tauri/target/
src-tauri/target-test/
*.log
witness-settings.toml
# Machine-local build tool locations (CMAKE, LIBCLANG_PATH). CONTRIBUTING.md
# asks developers to supply their own; they must never be committed.
.cargo/config.toml
/target/
/target-test/
/.worktrees/
